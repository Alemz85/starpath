{
  "name": "starpath-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -n next,electron -c blue,green \"next dev --port 3000\" \"npm run dev:electron\"",
    "dev:electron": "wait-on http://localhost:3000 && tsc -p tsconfig.electron.json && NODE_ENV=development electron .",
    "build": "next build && tsc -p tsconfig.electron.json",
    "package": "npm run build && electron-builder",
    "lint": "next lint",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "cmdk": "^1.0.0",
    "framer-motion": "^11.2.0",
    "fuse.js": "^7.0.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.441.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "recharts": "^2.12.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.0",
    "@tanstack/react-table": "^8.20.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.4.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "canvas-confetti": "^1.9.0",
    "electron-serve": "^1.3.0",
    "electron-updater": "^6.3.0",
    "better-sqlite3": "^11.3.0",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/canvas-confetti": "^1.6.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.0",
    "@electron/rebuild": "^3.6.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.starpath.desktop",
    "productName": "starpath",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**",
      "out/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ]
    },
    "win": {
      "icon": "assets/icon-1024.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "dmg": {
      "title": "starpath",
      "background": "assets/dmg-background.png",
      "window": { "width": 540, "height": 380 },
      "contents": [
        { "x": 150, "y": 185, "type": "file" },
        { "x": 390, "y": 185, "type": "link", "path": "/Applications" }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "santifer",
      "repo": "career-ops"
    }
  }
}
