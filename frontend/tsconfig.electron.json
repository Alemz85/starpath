{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "electron/**/*",
    "src/lib/parsers/**/*",
    "src/lib/chat/**/*",
    "src/types/**/*"
  ],
  "exclude": ["node_modules", "**/*.test.ts"]
}
