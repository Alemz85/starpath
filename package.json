{
  "name": "starpath",
  "version": "1.0.0",
  "description": "AI-powered job search pipeline built on Claude Code, with the starpath desktop GUI on top",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/verify-pipeline.mjs",
    "normalize": "node scripts/normalize-statuses.mjs",
    "dedup": "node scripts/dedup-tracker.mjs",
    "merge": "node scripts/merge-tracker.mjs",
    "pdf": "node scripts/generate-pdf.mjs",
    "ats-coverage": "node scripts/ats-coverage.mjs",
    "sync-check": "node scripts/cv-sync-check.mjs",
    "liveness": "node scripts/check-liveness.mjs",
    "research": "node scripts/company-research.mjs",
    "scan": "node scripts/scan.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "test:all": "node scripts/test-all.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "automation",
    "electron",
    "starpath"
  ],
  "author": "Alessandro Mezzanotte <alezco85@gmail.com>",
  "homepage": "https://github.com/Alemz85/starpath",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alemz85/starpath.git"
  },
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.1",
    "playwright": "^1.58.1"
  }
}
