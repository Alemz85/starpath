# Personal data (user fills these)
data/applications.md
data/pipeline.md
data/scan-history.tsv
data/scouting.md
data/score-history.tsv
data/comp-cache.tsv
data/report-summaries.tsv
data/dedup-index.tsv
# Agent issue log — operational self-reports, shared across profiles (not a profile symlink)
data/agent-log.tsv
# Session handoff log — conversational thread state, shared across profiles (not a profile symlink)
data/session-handoff.md
# All reports content is per-profile personal data; only the tracked
# reports/.gitkeep survives (the six content subdirs are profile symlinks
# managed by scripts/profile.mjs).
reports/*
!reports/.gitkeep

# Multi-profile personal data (real files behind the canonical symlinks;
# managed by scripts/profile.mjs)
profiles/

# Interview prep (personal)
interview-prep/*.md
interview-prep/**/*.md
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
# Derived user data — compact CV summary generated by scripts/cv-summary.mjs
batch/cv-summary.md
batch/tracker-additions/**/*.tsv
!batch/tracker-additions/.gitkeep
batch/scouting-additions/**/*.tsv
batch/scouting-additions/merged/
!batch/scouting-additions/.gitkeep
jds/*
!jds/.gitkeep

# User config and customization (never auto-updated)
user/profile.yml
user/portals.yml
user/_profile.md
user/cv.md
user/article-digest.md
.update-dismissed
.update-lock

# Generated
.resolved-prompt-*
node_modules/
bun.lock

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
career-dashboard
package-lock.json

# Agent skills — only project-specific career-ops* skills are tracked.
# Everything else under .claude/skills/ is user-installed tooling that
# varies machine-to-machine and shouldn't ship in the repo.
.claude/skills/*
!.claude/skills/career-ops/
!.claude/skills/career-ops-setup/

