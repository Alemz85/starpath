# ── Personal data: ONE private root, fail-closed ─────────────────────────────
# Everything personal lives in private/ (its own private git repo; see
# DATA_CONTRACT.md). The repo-root user/ data/ reports/ … paths are links into
# it. Patterns have no trailing slash so they match the links and any real
# folder of the same name; there are no ! re-includes, ever.
/private/
/user
/data
/reports
/interview-prep
/output
/jds
/profiles
/batch/tracker-additions
/batch/scouting-additions
/batch/work/
/batch/logs
/batch/jobspy-merged
/batch/batch-state.tsv
/batch/batch-input.tsv
/batch/cv-summary.md
/batch/pipeline-run-*/
/batch/positioning-compute.json
/batch/positioning-compute.mjs
# Personal to-do notes stay local, whatever they are called.
*[Tt][Oo][Dd][Oo]*.md
*[Tt][Oo][Dd][Oo]*.txt
/[Tt][Oo][Dd][Oo]
/[Tt][Oo][Dd][Oo][Ss]
# The demo dataset is tracked, but the app's demo chat store never is.
/demo/chat/
.update-dismissed
.update-lock

# Generated
.resolved-prompt-*
node_modules
bun.lock

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
.claude/worktrees/
career-dashboard
package-lock.json

# Agent skills — only project-specific career-ops* skills are tracked.
# Everything else under .claude/skills/ is user-installed tooling that
# varies machine-to-machine and shouldn't ship in the repo.
.claude/skills/*
!.claude/skills/career-ops/
!.claude/skills/career-ops-setup/

# Third-party AI/coding tool workspaces — these tools drop dotdirs at the
# repo root for their own state; none belong in the project.
.adal/
.agents/
.aider-desk/
.augment/
.bob/
.codeartsdoer/
.codebuddy/
.codemaker/
.codestudio/
.commandcode/
.continue/
.cortex/
.crush/
.devin/
.factory/
.forge/
.goose/
.iflow/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.next/
.openhands/
.pi/
.pochi/
.qoder/
.qwen/
.roo/
.rovodev/
.tabnine/
.trae/
.vibe/
.windsurf/
.zencoder/

# Claude Code skills installer artifacts (managed locally, not committed).
# Leading slash anchors to repo root so this doesn't accidentally match
# `.claude/skills/` (which has its own rule above).
/skills/
/skills-lock.json

# Playwright MCP session artifacts
.playwright-mcp/


# JobSpy aggregator scraper (scripts/jobspy/)
scripts/jobspy/.venv/
scripts/jobspy/__pycache__/


# Screenshots dropped at repo root for sharing context (e.g. with Claude).
# These are local artifacts, not project assets.
/Screenshot*.png
/Screenshot*.jpg
/Screenshot*.jpeg
